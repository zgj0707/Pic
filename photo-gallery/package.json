{
  "name": "photo-gallery",
  "version": "4.2.0",
  "description": "拍摄前参考样片收集与整理工具",
  "main": "./dist-app/main/main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && node scripts/build-content.mjs && electron-vite dev",
    "build": "npm run typecheck && node scripts/copy-vendor.mjs && electron-vite build && node scripts/build-content.mjs",
    "copy-vendor": "node scripts/copy-vendor.mjs",
    "sync:git": "cd .. && C:\\Users\\Administrator\\.workbuddy\\vendor\\PortableGit\\cmd\\git.exe add -A && C:\\Users\\Administrator\\.workbuddy\\vendor\\PortableGit\\cmd\\git.exe commit -m \"%COMMIT_MSG%\" && C:\\Users\\Administrator\\.workbuddy\\vendor\\PortableGit\\cmd\\git.exe push origin main",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint electron tests scripts",
    "lint:fix": "eslint electron tests scripts --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^35.20.0",
    "jimp": "^1.6.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.17",
    "electron": "^36.2.0",
    "electron-builder": "^26.1.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.1.6",
    "vitest": "^3.1.0"
  },
  "build": {
    "appId": "com.photogallery.app",
    "productName": "Pic",
    "directories": {
      "output": "dist-pkg"
    },
    "files": [
      "dist-app/main/**/*",
      "dist-app/preload/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/exiftool-vendored/**/*",
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/changelog.json",
        "to": "changelog.json"
      },
      {
        "from": "dist-app/content",
        "to": "modules"
      }
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.ico",
      "artifactName": "Pic-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "Pic-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "removePackageScripts": true
  }
}
