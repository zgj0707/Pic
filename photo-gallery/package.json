{
  "name": "photo-gallery",
  "version": "2.5.1",
  "description": "独立摄影师样片库管理软件",
  "main": "./dist-app/main/main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "node scripts/build-content.mjs && electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/build-content.mjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "exiftool-vendored": "^35.20.0",
    "jimp": "^1.6.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "electron": "^36.2.0",
    "electron-builder": "^26.1.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.1.6",
    "vitest": "^3.1.0"
  },
  "build": {
    "appId": "com.photogallery.app",
    "productName": "Pic",
    "directories": {
      "output": "dist-pkg"
    },
    "files": [
      "dist-app/main/**/*",
      "dist-app/preload/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/exiftool-vendored/**/*",
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/changelog.json",
        "to": "changelog.json"
      },
      {
        "from": "dist-app/content",
        "to": "modules"
      }
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icons/icon.ico",
      "artifactName": "Pic-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "Pic-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "removePackageScripts": true
  }
}
